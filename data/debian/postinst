#!/bin/sh
set -eu

if [ "$1" = configure ]; then
    if ! getent passwd sonic-image >/dev/null; then
        adduser --system --group --no-create-home --home /nonexistent \
            --shell /usr/sbin/nologin sonic-image
    fi
    getent passwd sonic-image | awk -F: '
        $3 > 0 && $4 > 0 && $7 == "/usr/sbin/nologin" { valid = 1 }
        END { exit !valid }
    ' || {
        echo "Invalid sonic-image service account" >&2
        exit 1
    }
fi

#DEBHELPER#
