#!/usr/bin/env python3

import argparse

from dldd.config import ConfigDBProvider, DLDDConfig, load_vendor_defaults
from dldd.platform import detect_identity
from dldd.watcher import RulesWatcher


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--inbox", default="/var/lib/sonic/dldd/inbox/dld_rules.yaml")
    parser.add_argument("--lock", default="/var/lib/sonic/dldd/rules/.dldd-rules-update.lock")
    parser.add_argument("--state", default="/var/lib/sonic/dldd/rules/.watch-state.json")
    parser.add_argument("--settle-time", type=int)
    args = parser.parse_args()
    settle_time = args.settle_time
    if settle_time is None:
        try:
            identity = detect_identity()
            defaults = load_vendor_defaults(
                "/usr/share/sonic/device/{}/dldd-config.yaml".format(
                    identity.platform
                )
            )
            settle_time = DLDDConfig.from_sources(
                ConfigDBProvider().load(), defaults
            ).rules_inbox_settle_time
        except Exception:
            settle_time = DLDDConfig().rules_inbox_settle_time
    return 0 if RulesWatcher(
        args.inbox, args.lock, args.state, settle_time
    ).check_once() else 0


if __name__ == "__main__":
    raise SystemExit(main())
